<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_live_status_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layoutDirection="ltr">

    <!-- Left info: Prayer Name & Time, Subtitle: Hijri & Location -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start|center_vertical"
        android:layoutDirection="ltr">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/live_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textColor="#F4F8F3"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="•"
                android:textColor="#8CA389"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/live_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:17"
                android:textColor="#A5C89E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/live_sub_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cairo • 15 Rabi' al-Thani"
            android:textColor="#8CA389"
            android:textSize="10.5sp"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right info: Live countdown pill -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_countdown_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <Chronometer
            android:id="@+id/live_countdown_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A5C89E"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
