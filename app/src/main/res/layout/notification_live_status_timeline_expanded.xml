<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_live_status_card"
    android:padding="10dp"
    android:layoutDirection="ltr">

    <!-- Top Row: Next Prayer Summary & Countdown & Location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:layoutDirection="ltr">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/live_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr"
                    android:textColor="#F4F8F3"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAlignment="viewStart"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/live_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="05:17"
                    android:textColor="#A5C89E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAlignment="viewStart"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/live_sub_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cairo • 15 Rabi' al-Thani 1448 AH"
                android:textColor="#8CA389"
                android:textSize="10sp"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_countdown_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <Chronometer
                android:id="@+id/live_countdown_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A5C89E"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#1E2A1C" />

    <!-- Bottom Row: 6 Daily Prayer Chips Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

        <!-- Fajr -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp">
            <ImageView
                android:id="@+id/live_bg_active_fajr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_active"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/live_bg_idle_fajr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_idle"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/live_name_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/live_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="05:17"
                    android:textColor="#C8D6C6"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- Sunrise -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp">
            <ImageView
                android:id="@+id/live_bg_active_sunrise"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_active"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/live_bg_idle_sunrise"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_idle"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/live_name_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunrise"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/live_time_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="06:44"
                    android:textColor="#C8D6C6"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- Dhuhr -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp">
            <ImageView
                android:id="@+id/live_bg_active_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_active"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/live_bg_idle_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_idle"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/live_name_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dhuhr"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/live_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="12:45"
                    android:textColor="#C8D6C6"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- Asr -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp">
            <ImageView
                android:id="@+id/live_bg_active_asr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_active"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/live_bg_idle_asr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_idle"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/live_name_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asr"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/live_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="16:10"
                    android:textColor="#C8D6C6"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- Maghrib -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp">
            <ImageView
                android:id="@+id/live_bg_active_maghrib"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_active"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/live_bg_idle_maghrib"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_idle"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/live_name_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maghrib"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/live_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="18:45"
                    android:textColor="#C8D6C6"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- Isha -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp">
            <ImageView
                android:id="@+id/live_bg_active_isha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_active"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/live_bg_idle_isha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_chip_idle"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/live_name_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isha"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/live_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="20:05"
                    android:textColor="#C8D6C6"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
