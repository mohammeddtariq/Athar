<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_surface"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:layoutDirection="rtl">

        <!-- Top row: Next Prayer & Hijri date on Start (right), Location & Settings on End (left) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start|center_vertical"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/widget_label_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصلاة التالية"
                    android:textColor="#C8D6C6"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textAlignment="viewStart"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="١٥ ربيع الآخر ١٤٤٨ هـ"
                    android:textColor="#8CA389"
                    android:textSize="9.5sp"
                    android:textAlignment="viewStart"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_location_pin"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_location_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="6dp"
                    android:text="موقعي"
                    android:textColor="#C8D6C6"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="80dp" />

                <ImageView
                    android:id="@+id/widget_btn_settings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_widget_settings"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main section: Prayer Name and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:layout_marginTop="2dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/widget_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#F4F8F3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_prayer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أذان الفجر"
                android:textColor="#8CA389"
                android:textSize="11sp"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="٠٥:١٧"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Bottom row: Countdown pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/widget_remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الوقت المتبقي"
                android:textColor="#A5C89E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_countdown_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <Chronometer
                    android:id="@+id/widget_countdown_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A5C89E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
