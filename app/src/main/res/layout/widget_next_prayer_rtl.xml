<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_surface"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:layoutDirection="rtl">

        <!-- Top row: short "next" label on Start (right), location + settings on End (left) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/widget_label_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التالية"
                android:textColor="#C8D6C6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:src="@drawable/ic_location_pin"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_location_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:text="موقعي"
                    android:textColor="#8CA389"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="42dp" />

                <ImageView
                    android:id="@+id/widget_btn_settings"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:padding="1dp"
                    android:src="@drawable/ic_widget_settings"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dates get their own full-width lines so they never squeeze the label -->
        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="١٥ جمادى الآخرة ١٤٤٨ هـ"
            android:textColor="#8CA389"
            android:textSize="9.5sp"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_gregorian_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="٢٥ نوفمبر ٢٠٢٦ م"
            android:textColor="#8CA389"
            android:textSize="9.5sp"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Main section: Prayer Name and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:layout_marginTop="2dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/widget_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#F4F8F3"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/widget_prayer_name_image"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_prayer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أذان المغرب"
                android:textColor="#8CA389"
                android:textSize="10.5sp"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="١٦:٥٤"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/widget_prayer_time_image"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="1dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Bottom row: Time Remaining label + countdown pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/widget_remaining_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="المتبقي"
                android:textColor="#A5C89E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:ellipsize="end" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_countdown_pill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_widget_countdown_pill_neutral"
                    android:contentDescription="@null" />

                <Chronometer
                    android:id="@+id/widget_countdown_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#A5C89E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="٠٠:٠٠"
                    android:textColor="#A5C89E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
