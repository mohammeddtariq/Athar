<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_surface"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:layoutDirection="ltr">

        <!-- Top row: Hijri & Gregorian dates on Start, Next Prayer label & Location on End -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <!-- Date column on Start -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start|center_vertical"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/widget_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 Rabi' al-Thani 1448 AH"
                    android:textColor="#8CA389"
                    android:textSize="9.5sp"
                    android:textAlignment="viewStart"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_gregorian_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="26 September 2026"
                    android:textColor="#8CA389"
                    android:textSize="9.5sp"
                    android:textAlignment="viewStart"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Next Prayer & Location & Settings on End -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/widget_label_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Prayer"
                    android:textColor="#C8D6C6"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textAlignment="viewEnd"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layoutDirection="ltr">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_location_pin"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_location_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="6dp"
                        android:text="My Location"
                        android:textColor="#8CA389"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="80dp" />

                    <ImageView
                        android:id="@+id/widget_btn_settings"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="2dp"
                        android:src="@drawable/ic_widget_settings"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Main section: Prayer Name and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:layout_marginTop="2dp"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/widget_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textColor="#F4F8F3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/widget_prayer_name_image"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_prayer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adhan for Fajr"
                android:textColor="#8CA389"
                android:textSize="11sp"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="05:17"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/widget_prayer_time_image"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Bottom row: Countdown pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/widget_remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Remaining"
                android:textColor="#A5C89E"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:maxLines="1" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_countdown_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <Chronometer
                    android:id="@+id/widget_countdown_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A5C89E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
