<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_surface"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 1. All prayers in one row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Fajr -->
            <FrameLayout
                android:id="@+id/widget_item_fajr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:background="@drawable/bg_widget_normal_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:17"
                        android:textColor="#E0E6DF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Sunrise -->
            <FrameLayout
                android:id="@+id/widget_item_sunrise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:background="@drawable/bg_widget_normal_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:44"
                        android:textColor="#E0E6DF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Dhuhr -->
            <FrameLayout
                android:id="@+id/widget_item_dhuhr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:background="@drawable/bg_widget_normal_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:47"
                        android:textColor="#E0E6DF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Asr -->
            <FrameLayout
                android:id="@+id/widget_item_asr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:background="@drawable/bg_widget_normal_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:11"
                        android:textColor="#E0E6DF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Maghrib -->
            <FrameLayout
                android:id="@+id/widget_item_maghrib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:background="@drawable/bg_widget_normal_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:47"
                        android:textColor="#E0E6DF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Isha -->
            <FrameLayout
                android:id="@+id/widget_item_isha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:background="@drawable/bg_widget_normal_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_isha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_isha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:05"
                        android:textColor="#E0E6DF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Vertical Separator -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#2C3A2A"
            android:contentDescription="@null" />

        <!-- 2. Next Prayer summary, Countdown & Settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="95dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr"
                    android:textColor="#F4F8F3"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="05:17"
                    android:textColor="#A5C89E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/widget_btn_settings"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_settings"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_next_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cairo"
                android:textColor="#8CA389"
                android:textSize="10sp"
                android:maxLines="1"
                android:maxWidth="90dp"
                android:ellipsize="end" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_widget_countdown_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <Chronometer
                    android:id="@+id/widget_countdown_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A5C89E"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
