<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_surface"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- 1. Next Prayer Hero Summary -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:minWidth="95dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/widget_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr"
                    android:textColor="#F4F8F3"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAlignment="viewStart"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="05:17"
                    android:textColor="#A5C89E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAlignment="viewStart"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/widget_btn_settings"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:padding="1dp"
                    android:src="@drawable/ic_widget_settings"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_next_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Cairo"
                android:textColor="#8CA389"
                android:textSize="9.5sp"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:maxWidth="85dp"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="15 Rabi' al-Thani"
                android:textColor="#8CA389"
                android:textSize="8.5sp"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:maxWidth="95dp"
                android:ellipsize="end" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_widget_countdown_pill"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <Chronometer
                    android:id="@+id/widget_countdown_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A5C89E"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Vertical Separator -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="6dp"
            android:background="#1E2A1C"
            android:contentDescription="@null" />

        <!-- 2. All 6 Prayers horizontal timeline strip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Fajr -->
            <FrameLayout
                android:id="@+id/widget_item_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_widget_chip_idle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="05:17"
                        android:textColor="#C8D6C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Sunrise -->
            <FrameLayout
                android:id="@+id/widget_item_sunrise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_widget_chip_idle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="06:44"
                        android:textColor="#C8D6C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Dhuhr -->
            <FrameLayout
                android:id="@+id/widget_item_dhuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_widget_chip_idle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="12:47"
                        android:textColor="#C8D6C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Asr -->
            <FrameLayout
                android:id="@+id/widget_item_asr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_widget_chip_idle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="16:11"
                        android:textColor="#C8D6C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Maghrib -->
            <FrameLayout
                android:id="@+id/widget_item_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_widget_chip_idle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="18:47"
                        android:textColor="#C8D6C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>

            <!-- Isha -->
            <FrameLayout
                android:id="@+id/widget_item_isha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_widget_chip_idle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/widget_name_isha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/widget_time_isha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="20:05"
                        android:textColor="#C8D6C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
